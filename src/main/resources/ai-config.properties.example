# ============================================================
# 大模型配置文件模板
# ------------------------------------------------------------
# 使用方法：
#   1. 复制本文件并去掉 .example 后缀：
#        Windows:  copy src\main\resources\ai-config.properties.example src\main\resources\ai-config.properties
#        macOS/Linux: cp src/main/resources/ai-config.properties.example src/main/resources/ai-config.properties
#   2. 把 ai.api.key 换成你自己的密钥
#
# 注意：
#   - 真实的 ai-config.properties 已被 .gitignore 排除，不会提交到仓库
#   - 生产环境建议改用外部文件或环境变量，不要把密钥打进 WAR：
#       ${catalina.base}/conf/ai-config.properties
#       ~/.3a-ai-config.properties
#       AI_API_KEY / AI_BASE_URL / AI_MODEL / AI_TIMEOUT_SECONDS
#   - 不配置也能运行，AI 攻略会返回占位内容、桌宠使用内置台词
# ============================================================

# 兼容 OpenAI 协议的接口地址（默认 SiliconFlow）
ai.base.url=https://api.siliconflow.cn/v1

# API 密钥，留空表示不启用大模型功能
ai.api.key=

# 模型名称
ai.model=deepseek-ai/DeepSeek-V4-Flash

# 请求超时（秒）
ai.timeout.seconds=60