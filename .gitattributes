# 统一换行符处理，保证 Windows / macOS / Linux 检出结果一致
* text=auto

# Shell 脚本必须使用 LF，否则在 Linux/macOS 上无法执行
*.sh   text eol=lf
mvnw   text eol=lf

# Windows 批处理使用 CRLF
*.cmd  text eol=crlf
*.bat  text eol=crlf

# 二进制资源不做换行符转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.jar  binary
*.zip  binary